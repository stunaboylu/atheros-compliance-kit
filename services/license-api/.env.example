DATABASE_URL=postgresql+asyncpg://licence:licence@localhost:5432/licence

# Ed25519 private key, PEM. Generate with:  python -m app.keys generate
# In production this comes from a KMS or secret manager, never from an image and
# never from the repository. It is the only private key in the entire product.
ATHEROS_SIGNING_KEY_PEM=

# Key id published in JWKS and carried in each token header.
SIGNING_KEY_ID=atheros-2026

# Salt for machine-fingerprint hashing. Required — the service refuses to boot
# without it, because an unsalted fingerprint is a stable cross-customer
# identifier sitting in a database that is meant to hold nothing of the sort.
ATHEROS_FINGERPRINT_SALT=

# Token lifetime in days. This is a GRACE PERIOD, not a heartbeat: at 90 days a
# customer whose network cannot reach us keeps building for a quarter.
TOKEN_DAYS=90

DEBUG=false
