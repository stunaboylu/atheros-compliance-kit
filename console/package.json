{
  "name": "atheros-compliance-console",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only console for reports emitted by the AtherosAI Compliance Kit. Expo Router universal app — web is the primary target, iOS/Android come from the same source.",
  "main": "expo-router/entry",
  "scripts": {
    "web": "expo start --web",
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint"
  },
  "dependencies": {
    "expo": "~52.0.0",
    "expo-asset": "~11.0.0",
    "expo-constants": "~17.0.0",
    "expo-font": "~13.0.4",
    "expo-linking": "~7.0.0",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "^5.3.3"
  }
}
